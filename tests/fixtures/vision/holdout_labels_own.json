{
  "_what": "M3 held-out reference labels, own-account half. 40 publications, none of them in the 24-video tuning set.",
  "_labelled_by": "Claude (Opus 5), from four-frame strips at t=0,1,2,3s, 2026-10-27.",
  "_ordering_disclosure": "Labelled BEFORE any inference was run against these 40. No model or detector output was consulted. The strips were generated by scripts/provision/make_holdout_strips.py and viewed directly.",
  "_who_should_check_this": "The owner. These are not his labels, and they decide which vision fields may ever be promoted. Rows listed in `_uncertain` are the ones where a second opinion would change something; the rest are unambiguous on the strip.",
  "_rule": "A field is true if the thing is visible in ANY of the four frames, matching the hook-window rule used for human_labels_v2.json so the two sets stay comparable.",
  "_definitions": {
    "performer_visible": "Any part of a person performing. Hands alone count.",
    "piano_or_keyboard_visible": "Piano keys visible. A piano body with no keys showing does NOT count - several concert shots are side-on and were marked false for exactly this reason.",
    "hands_visible": "Hands anywhere in frame, on the keys or not.",
    "face_visible": "A recognisable human face. Back of head does not count. A face too small to resolve does not count.",
    "sheet_music_visible": "Printed musical notation visible anywhere, including framed notation on a wall and graphic notation overlaid on the video. See _ambiguity.",
    "text_overlay_present": "Burned-in caption or title text added by the creator."
  },
  "_ambiguity": {
    "sheet_music_on_the_wall": "Publications 217, 287 and 496 show framed musical notation hanging on the wall behind the piano, not music being read. The literal definition says notation is visible, so they are TRUE - but a model that learns 'sheet music means the performer is reading from a score' will be marked wrong on them, and that is a definition disagreement rather than a model error. Flagged in _uncertain.",
    "graphic_notation_overlay": "Publications 39, 305, 320 and 389 show notation as a graphic strip composited into the video rather than physical paper. Also TRUE by the literal reading.",
    "faces_at_concert_distance": "Publications 3, 91 and 259 are wide concert shots where a face occupies a few dozen pixels. Marked FALSE on the ground that it is not resolvable, which is a judgement call."
  },
  "_base_rates_warning": "Measured on these 40: piano_or_keyboard_visible is true in 34 (always-yes scores 0.850), text_overlay_present in 39 (always-yes scores 0.975), hands_visible in 37 (0.925), performer_visible in 40 - NO VARIANCE, nothing can be learned from it. Only face_visible (18/40, baseline 0.550) and sheet_music_visible (12/40, baseline 0.700) have enough balance to discriminate. Any accuracy figure on the others must be reported against its baseline or it is meaningless (CLAUDE.md 3.7).",
  "_uncertain": [
