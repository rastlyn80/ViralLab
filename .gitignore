# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.token
credentials.json
*.pem
*.key
.ssh/

# --- raw third-party data (DO NOT COMMIT) ------------------------------------
# Provider samples contain other creators' data. Committing them would
# redistribute personal data and breach the operating policy in
# DEVELOPMENT_PLAN.md 2.3 ("no redistribution beyond research need; never
# build a resellable creator database"). Synthetic fixture_*.json files are
# safe and ARE tracked, because they contain no real data.
probes/**/sample_*.json
probes/**/*.run.json
# Any file derived FROM scraped output - re-query id lists, inputs built
# from harvested usernames or video URLs. These carry third-party
# identifiers even when they are not the sample itself. Convention:
# name anything derived from provider data *.local.json.
*.local.json
data/
samples/

# --- media -------------------------------------------------------------------
media/
masters/
frames/
*.mp4
*.mov
*.m4a
*.wav
*.webm
*.jpg
*.jpeg
*.png
!docs/**/*.png

