models/
*.gguf
*.safetensors
*.onnx
*.pt
*.pkl
*.joblib

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv*/
venv/
env/
# Portable Postgres cluster used for local development (binaries + data dir)
.pgsql/
# Phase 0B probe outputs: benchmark result files and extracted work dirs
probes/**/*_results.json
probes/**/media/
probes/**/_work*/
probes/**/*.wav
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

